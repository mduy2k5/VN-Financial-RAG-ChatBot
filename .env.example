# Financial RAG standalone configuration
FINANCIAL_BIND_ADDRESS=127.0.0.1
FINANCIAL_HOST_PORT=8092
FINANCIAL_UI_BIND_ADDRESS=127.0.0.1
FINANCIAL_UI_HOST_PORT=8093
# Keep dense embeddings off by default on a low-RAM host; BM25 remains available.
FINANCIAL_ENABLE_DENSE=false
FINANCIAL_LOAD_SAMPLE_DATA=false

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional SLM for explicit query exclusions; unset uses conservative lexical filtering.
FINANCIAL_FILTER_MODEL=
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_CTX=4096

FINANCIAL_EMBEDDING_URL=http://host.docker.internal:11434
FINANCIAL_EMBEDDING_MODEL=qllama/multilingual-e5-large:q4_k_m
